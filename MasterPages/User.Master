<%@ Master Language="C#" AutoEventWireup="true" CodeFile="User.Master.cs" Inherits="MasterPages_User" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Tour Booking</title>
    <link href="~/Styles/site.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/user.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/responsive.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-layout">
            <!-- Traveler Sidebar -->
            <aside id="appSidebar" class="app-sidebar">
                <div class="sidebar-header">
                    <a href='<%= ResolveUrl("~/User/Dashboard.aspx") %>' class="brand-logo">
                        <svg class="brand-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm9 15H5V8h14v11z"/>
                        </svg>
                        <span>Tour Booking</span>
                    </a>
                </div>

                <nav class="sidebar-nav">
                    <a href='<%= ResolveUrl("~/User/Dashboard.aspx") %>' class='sidebar-link <%= IsActive("Dashboard.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/BrowseTours.aspx") %>' class='sidebar-link <%= IsActive("BrowseTours.aspx", "TourDetails.aspx", "Booking.aspx", "Payment.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <span>Browse Tours</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/MyBookings.aspx") %>' class='sidebar-link <%= IsActive("MyBookings.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>My Bookings</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/Wishlist.aspx") %>' class='sidebar-link <%= IsActive("Wishlist.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        <span>Wishlist</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/MyReviews.aspx") %>' class='sidebar-link <%= IsActive("MyReviews.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <span>My Reviews</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/Offers.aspx") %>' class='sidebar-link <%= IsActive("Offers.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        <span>Offers</span>
                    </a>
                    <a href='<%= ResolveUrl("~/User/Profile.aspx") %>' class='sidebar-link <%= IsActive("Profile.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>My Profile</span>
                    </a>
                    <div class="sidebar-divider"></div>
                    <a href='<%= ResolveUrl("~/Public/Login.aspx") %>' class="sidebar-link">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Logout</span>
                    </a>
                </nav>
            </aside>

            <!-- Main App Body -->
            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button type="button" id="menuToggleBtn" class="menu-toggle-btn" aria-label="Toggle Menu">
                            <svg class="icon-svg" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                        </button>
                        <h1 class="page-title"><asp:ContentPlaceHolder ID="TitleContent" runat="server"><%: Page.Title %></asp:ContentPlaceHolder></h1>
                    </div>
                    <div class="topbar-right">
                        <a href='<%= ResolveUrl("~/User/Profile.aspx") %>' class="topbar-user">
                            <span class="topbar-user-avatar">A</span>
                            <span>Hello, Arjun</span>
                            <svg class="icon-svg" style="width:14px; height:14px;" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </a>
                    </div>
                </header>

                <div class="content-body">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
    </form>
    <script src='<%= ResolveUrl("~/Scripts/site.js") %>'></script>
</body>
</html>
