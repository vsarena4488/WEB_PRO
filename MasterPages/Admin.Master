<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Admin.Master.cs" Inherits="MasterPages_Admin" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - TourBook Admin</title>
    <link href="~/Styles/site.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/user.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/admin.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/responsive.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-layout">
            <!-- Admin Sidebar -->
            <aside id="appSidebar" class="app-sidebar">
                <div class="sidebar-header">
                    <a href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>' class="brand-logo">
                        <svg class="brand-icon" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M19 6h-3V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H5c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-9-2h4v2h-4V4zm9 15H5V8h14v11z"/>
                        </svg>
                        <span>TourBook Admin</span>
                    </a>
                </div>

                <nav class="sidebar-nav">
                    <a href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>' class='sidebar-link <%= IsActive("Dashboard.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                        <span>Dashboard</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Tours.aspx") %>' class='sidebar-link <%= IsActive("Tours.aspx", "AddTour.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <span>Tours</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/TourSchedules.aspx") %>' class='sidebar-link <%= IsActive("TourSchedules.aspx", "AddSchedule.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                        <span>Tour Schedules</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Bookings.aspx") %>' class='sidebar-link <%= IsActive("Bookings.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        <span>Bookings</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Users.aspx") %>' class='sidebar-link <%= IsActive("Users.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>Users</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Offers.aspx") %>' class='sidebar-link <%= IsActive("Offers.aspx", "AddOffer.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                        <span>Offers</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Reviews.aspx") %>' class='sidebar-link <%= IsActive("Reviews.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        <span>Reviews</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Messages.aspx") %>' class='sidebar-link <%= IsActive("Messages.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <span>Messages</span>
                    </a>
                    <a href='<%= ResolveUrl("~/Admin/Profile.aspx") %>' class='sidebar-link <%= IsActive("Profile.aspx") %>'>
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span>Admin Profile</span>
                    </a>
                    <div class="sidebar-divider"></div>
                    <a href='<%= ResolveUrl("~/Public/Login.aspx") %>' class="sidebar-link">
                        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        <span>Logout</span>
                    </a>
                </nav>
            </aside>

            <!-- Main Admin Shell -->
            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button type="button" id="menuToggleBtn" class="menu-toggle-btn" aria-label="Toggle Menu">
                            <svg class="icon-svg" viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                        </button>
                        <h1 class="page-title"><asp:ContentPlaceHolder ID="TitleContent" runat="server"><%: Page.Title %></asp:ContentPlaceHolder></h1>
                    </div>
                    <div class="topbar-right">
                        <a href='<%= ResolveUrl("~/Admin/Profile.aspx") %>' class="topbar-user">
                            <span class="topbar-user-avatar">V</span>
                            <span>Hello, vishal</span>
                            <svg class="icon-svg" style="width:14px; height:14px;" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                        </a>
                    </div>
                </header>

                <div class="content-body">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
    </form>
    <script src='<%= ResolveUrl("~/Scripts/site.js") %>'></script>
</body>
</html>
